generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./tarefas.db"
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nome     String
  email    String   @unique
  senha    String
  token    String?  @unique
  tarefas  Tarefa[]
}

model Tarefa {
  id        Int     @id @default(autoincrement())
  titulo    String
  descricao String  @default("")
  concluida Boolean @default(false)
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
}

